{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "detection-summary/1",
  "description": "The summary of one model's detection test run (PLAN §4.16, report only), imported by an administrator through POST /api/v1/admin/detection-summaries. One entry per window length (1, 3 or 6 months shown), each with the five metrics: hits, the units scored and the chance base rate (8 decimal places). sourceSha256 is the SHA-256 of the raw result file the summary was computed from; the per-month answers stay in that file and are never sent. Shape only: the API also refuses a runAt that is not a real instant or lies in the future, hits above a metric's units, a metric's units above its window's units, and a trailing line break in any pattern-checked string. / 모델 하나의 탐지 시험 실행 요약(PLAN §4.16, 보고 전용)으로, 관리자가 POST /api/v1/admin/detection-summaries로 들여온다. 창 길이(보여 준 달 1·3·6)마다 항목 하나와 지표 다섯(맞힌 수, 채점한 단위 수, 우연 기준 적중률 소수 8자리)을 담는다. sourceSha256은 요약을 계산한 원본 결과 파일의 SHA-256이며, 달마다의 답은 그 파일에만 남고 보내지 않는다. 이 파일은 모양만 정한다: API는 실제 시각이 아니거나 미래인 runAt, 지표의 단위 수보다 큰 hits, 창의 단위 수보다 큰 지표 단위 수, 패턴으로 검사하는 문자열 끝의 줄바꿈도 거절한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "modelId",
    "testVersion",
    "sampleLayer",
    "runAt",
    "sourceSha256",
    "windows"
  ],
  "properties": {
    "schema": {
      "const": "detection-summary/1"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
    },
    "testVersion": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9-]*/[1-9][0-9]*$"
    },
    "sampleLayer": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[A-Z0-9][A-Z0-9-]*$"
    },
    "runAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "windows": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "1": {
          "$ref": "#/$defs/window"
        },
        "3": {
          "$ref": "#/$defs/window"
        },
        "6": {
          "$ref": "#/$defs/window"
        }
      }
    }
  },
  "$defs": {
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "metrics"
      ],
      "properties": {
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "YM_EXACT",
            "YM_WITHIN_3",
            "YEAR",
            "KR_NEXT",
            "US_NEXT"
          ],
          "properties": {
            "YM_EXACT": {
              "$ref": "#/$defs/score"
            },
            "YM_WITHIN_3": {
              "$ref": "#/$defs/score"
            },
            "YEAR": {
              "$ref": "#/$defs/score"
            },
            "KR_NEXT": {
              "$ref": "#/$defs/score"
            },
            "US_NEXT": {
              "$ref": "#/$defs/score"
            }
          }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hits",
        "units",
        "baseRate"
      ],
      "properties": {
        "hits": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "baseRate": {
          "type": "string",
          "pattern": "^(0\\.[0-9]{8}|1\\.00000000)$"
        }
      }
    }
  }
}
