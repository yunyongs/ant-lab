{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "allowJs": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Strictness */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "vite.proxy.ts",
    "vite.proxy*.test.ts",
    "scripts/**/*.ts",
    "eslint.restrictions.js",
    "src/test/apiSchema.test.ts",
    "src/test/ciWorkflow.test.ts",
    "src/test/e2eScript.test.ts",
    "src/test/lintRestrictions.test.ts",
    "src/test/packagePins.test.ts"
  ]
}
