# P0-08 가격 내려받기 도구(tools/fetch)용 변수 이름 목록. 값은 .env 에만 쓴다.
# .env 는 git 이 무시한다. 키·시크릿·토큰을 채팅·이슈·커밋·로그에 붙이지 않는다.

# KIS Developers 앱 키·시크릿
KIS_APP_KEY=
KIS_APP_SECRET=
# 도메인은 실전 고정이다(모의 도메인 없음). 이 도구는 시세 조회만 한다
# 선택: 토큰 캐시 폴더(저장소 안, 상대 경로는 저장소 루트 기준, 기본 data/cache/kis), 초당 요청 상한(기본 4)
# KIS_TOKEN_CACHE_DIR=data/cache/kis
# KIS_RPS=4

# FRED/ALFRED API key for the macro series collector (M1-07). Local only; the prod profile refuses to start with the collector on.
# The key goes in the request query string (FRED has no header option), so it must never appear in a URL, log or message.
FRED_API_KEY=

# ECOS (Bank of Korea) API key for the macro series collector (M1-08). Local only; the prod profile refuses to start with the collector on.
# The key is a URL path segment at ECOS, so it must never appear in a URL, log or message.
ECOS_API_KEY=

# Grafana admin password for the compose monitoring profile (MON-02). Required, no default. Use hex (openssl rand -hex 16): Compose expands $ in .env values.
GF_SECURITY_ADMIN_PASSWORD=
# Password of the Grafana PostgreSQL data source user grafana_reader (OBS-02). Empty locally (trust); set it only where the role has a password (db/README.md).
# GRAFANA_READER_PASSWORD=
# Password of the statistics role antlab_metrics that postgres_exporter uses (OBS-06). Empty locally (trust); set it only where the role has a password (db/README.md).
# ANTLAB_METRICS_PASSWORD=

# JWT signing key for the API (SEC-03). Required, no default. Generate: openssl rand -base64 32
ANTLAB_JWT_SECRET=

# Engine service token (M2-01). Required when the engine profile runs, no default. Generate: openssl rand -hex 32
ANTLAB_ENGINE_TOKEN=
# Where the API gets season paths (M2-06): java (default, in-process) or engine (the Python engine; needs the token above). Compose sets the engine URL itself.
# ANTLAB_ENGINE_PATH_SOURCE=java
# Engine URL for a run outside compose (for example ./gradlew bootRun against a local engine)
# ANTLAB_ENGINE_URL=http://127.0.0.1:8000
# Engine DB password (M2-03). Empty locally (trust); required in production.
# ANTLAB_ENGINE_DB_PASSWORD=
# Optional host port for the engine (local only, default 8000)
# ANTLAB_ENGINE_PORT=8000

# API DB passwords (MVP-20): empty locally (trust). Production passes them as secret files (DEPLOY section 9.1), not through .env.
# ANTLAB_DB_OWNER_PASSWORD=

# OpenRouter key for local live probes; never commit a value.
OPENROUTER_API_KEY=
# ANTLAB_OPENROUTER_LEDGER=/absolute/path/to/openrouter_ledger.jsonl
# ANTLAB_OPENROUTER_TIER=50
# Ledger exporter (OBS-08, profile monitoring). Host path of the Ollama Cloud spend file and the fetch tool's state folder (data/raw/mvp-04 of the main checkout; never data/ or data/cache); ANTLAB_OPENROUTER_LEDGER above is the third. Unset = that ledger is skipped.
# ANTLAB_OBS_OLLAMA_LEDGER=/absolute/path/to/ollama_cloud_spend.jsonl
# ANTLAB_OBS_FETCH_DIR=/absolute/path/to/data/raw/mvp-04
# The exporter runs as this user so it can read the 0600 OpenRouter ledger: id -u and id -g.
# ANTLAB_OBS_UID=
# ANTLAB_OBS_GID=
# Optional, blank = exporter default (stop 18; fetch caps equal the tool defaults, KIS 1..1500, YF 1..50).
# ANTLAB_OBS_OLLAMA_STOP_USD=
# ANTLAB_OBS_FETCH_CAP_KIS=
# ANTLAB_OBS_FETCH_CAP_YF=

# Agent runner service token and the owner member id (AG-02). No defaults: unset means every runner request is refused.
# Generate the token: openssl rand -hex 32
ANTLAB_AGENT_RUNNER_TOKEN=
ANTLAB_AGENT_RUNNER_OWNER_ID=

# Agent runner (AG-02), read by `python -m antlab_ai.runner` in ai/. Names only; the token is the same value as ANTLAB_AGENT_RUNNER_TOKEN above.
# ANTLAB_API_URL=http://127.0.0.1:8080
# ANTLAB_RUNNER_STATE_DIR=data/ai/runner
# ANTLAB_MODEL_STRUCTURED_OUTPUT=false
# Ollama is off until OLLAMA_BASE_URL is set; the runner uses a loopback address only.
# OLLAMA_BASE_URL=
# OLLAMA_API_KEY=

# Subscription CLI routes (AG-03), owner device only, off by default. Names only; none of them is a secret.
# A route runs only when the switch is true AND the route is listed. Never set an API-billing name
# (ANTHROPIC_API_KEY, OPENAI_API_KEY, ...) in the shell that starts a batch: the batch refuses.
# Refusals are fixed codes (API_KEY_SET, USAGE_STOP, LEDGER_UNSAFE, ...); a paused season uses the journal reasons USAGE_GUARD or SUBSCRIPTION_REFUSED. See ai/README.md.
ANTLAB_MODEL_SUBSCRIPTION_ENABLED=false
# ANTLAB_MODEL_SUBSCRIPTION_ROUTES=CLAUDE_CLI,CODEX_CLI
# ANTLAB_SUBSCRIPTION_OWNER_MEMBER_ID=
# ANTLAB_SUBSCRIPTION_USAGE_CMD=python3 /absolute/path/to/ai/scripts/usage_from_orca.py
# ANTLAB_SUBSCRIPTION_MAX_CALLS_PER_BATCH=15
# ANTLAB_SUBSCRIPTION_USAGE_MAX_AGE_S=900
# ANTLAB_SUBSCRIPTION_WORK_ROOT=
# ANTLAB_SUBSCRIPTION_CODEX_HOME=
# ANTLAB_SUBSCRIPTION_CLAUDE_CONFIG_DIR=
