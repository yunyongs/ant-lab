# P0-08 가격 내려받기 도구(tools/fetch)용 변수 이름 목록. 값은 .env 에만 쓴다.
# .env 는 git 이 무시한다. 키·시크릿·토큰을 채팅·이슈·커밋·로그에 붙이지 않는다.

# KIS Developers 앱 키·시크릿
KIS_APP_KEY=
KIS_APP_SECRET=
# 도메인은 실전 고정이다(모의 도메인 없음). 이 도구는 시세 조회만 한다
# 선택: 토큰 캐시 폴더(저장소 안, 상대 경로는 저장소 루트 기준, 기본 data/cache/kis), 초당 요청 상한(기본 4)
# KIS_TOKEN_CACHE_DIR=data/cache/kis
# KIS_RPS=4

# Grafana admin password for the compose monitoring profile (MON-02). Required, no default. Use hex (openssl rand -hex 16): Compose expands $ in .env values.
GF_SECURITY_ADMIN_PASSWORD=
