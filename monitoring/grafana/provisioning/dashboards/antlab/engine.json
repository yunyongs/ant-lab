          },
          "refId": "B",
          "expr": "sum(rate(antlab_engine_regime_evaluation_duration_seconds_sum{job=\"antlab-engine\"}[$__rate_interval])) / sum(rate(antlab_engine_regime_evaluation_duration_seconds_count{job=\"antlab-engine\"}[$__rate_interval]))",
          "legendFormat": "mean",
          "range": true
