          },
          "refId": "A",
          "expr": "(sum(rate(antlab_engine_http_requests_total{job=\"antlab-engine\",status=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(antlab_engine_http_requests_total{job=\"antlab-engine\"}[$__rate_interval]))",
