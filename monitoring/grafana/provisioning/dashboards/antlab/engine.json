          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(antlab_engine_http_request_duration_seconds_bucket{job=\"antlab-engine\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
