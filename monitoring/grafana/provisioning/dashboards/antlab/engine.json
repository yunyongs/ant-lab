  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "엔진 가동",
      "description": "**왜 있나** 엔진이 지표 포트로 응답하는지 보려는 칸입니다.\n\n**볼 것** Prometheus가 엔진 지표 포트에 닿으면 UP, 못 닿으면 DOWN(빨강)입니다.\n\n**정상·이상** UP이 정상입니다. 엔진을 일부러 끈 때만 DOWN이 정상입니다.\n\n**이상하면** 엔진 컨테이너 상태와 로그를 확인합니다. 1분 넘게 내려가면 '엔진 대상 중단' 경보가 울립니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "no target",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "min(up{job=\"antlab-engine\"})",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "초당 요청 수",
      "description": "**왜 있나** 엔진이 받는 요청의 양을 보려는 칸입니다.\n\n**볼 것** 최근 5분 모든 경로의 초당 요청 수(req/s)입니다.\n\n**정상·이상** 엔진 기능을 쓸 때만 오르고 평소엔 0에 가까운 것이 정상입니다.\n\n**이상하면** API 대시보드의 엔진 호출과 같은 시각에 맞춥니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(antlab_engine_http_requests_total{job=\"antlab-engine\"}[5m]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "오류 비율",
      "description": "**왜 있나** 엔진이 서버 오류를 내는지 보려는 칸입니다.\n\n**볼 것** 최근 5분 응답 중 5xx 비율(%)입니다.\n\n**정상·이상** 0%가 정상이고 5%를 넘으면 빨강입니다.\n\n**이상하면** 경로별 요청과 엔진 로그에서 어느 경로가 실패하는지 봅니다.\n\n**주의** 요청이 없으면 값이 비어 보입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "(sum(rate(antlab_engine_http_requests_total{job=\"antlab-engine\",status=~\"5..\"}[5m])) or vector(0)) / sum(rate(antlab_engine_http_requests_total{job=\"antlab-engine\"}[5m]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "사용 중인 투영 슬롯",
      "description": "**왜 있나** 동시에 도는 투영이 슬롯 한도에 얼마나 가까운지 보려는 칸입니다.\n\n**볼 것** 지금 실행 중인 투영 수입니다(슬롯 수는 투영 슬롯 패널의 capacity).\n\n**정상·이상** 여유가 있을 때는 낮고, 2에서 주황, 3에서 빨강입니다. 한도에 붙으면 새 투영이 대기하거나 거절될 수 있습니다.\n\n**이상하면** 투영 슬롯 추이와 프로세스 CPU·메모리를 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "max(antlab_engine_projection_slots_in_use{job=\"antlab-engine\"})",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "프로세스 메모리",
      "description": "**왜 있나** 엔진 프로세스가 메모리를 얼마나 쓰는지 보려는 칸입니다.\n\n**볼 것** 엔진 프로세스의 현재 상주 메모리(바이트)입니다.\n\n**정상·이상** 평소 값 근처에서 평평하면 정상입니다. 컨테이너 한도에 가까워지면 위험합니다.\n\n**이상하면** 프로세스 메모리 추이에서 계속 오르는지 확인하고 투영 부하를 봅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
