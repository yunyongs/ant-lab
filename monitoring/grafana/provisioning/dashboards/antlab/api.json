            "uid": "antlab-prometheus"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{application=~\"$application\",uri!~\"/readyz|/livez|/actuator/.*\"}[$__rate_interval])))",
          "legendFormat": "p99",
