    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "Request latency quantiles from the histogram buckets (5 ms to 10 s). / 히스토그램 버킷(5ms~10s)으로 계산한 요청 지연 분위수.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
