          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=~\"$application\",uri!~\"/readyz|/livez|/actuator/.*\",status=~\"4..|5..\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "range": true
