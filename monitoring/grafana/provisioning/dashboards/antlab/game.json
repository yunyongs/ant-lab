      "id": 1,
      "type": "stat",
      "title": "Turns committed in range",
      "description": "Turn advances that finished in the selected time range. The first event of a new label set is not counted (increase needs an earlier sample). / 선택한 시간 범위에서 끝난 턴 전환 수. 새 라벨 조합의 첫 이벤트는 세지 않는다(increase는 앞선 표본이 있어야 센다).",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(antlab_turn_advance_total{application=~\"$application\",outcome=\"committed\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
