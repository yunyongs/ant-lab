  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "기간 내 턴 전환 수",
      "description": "시각화 이유: 선택한 기간에 턴이 몇 번 정상적으로 넘어갔는지 보려는 칸입니다.\n\n확인 지표: outcome이 committed인 턴 전환의 합계(건)입니다.\n\n정상 범위: 시즌을 진행한 때만 오르고 안 쓰면 0인 것이 정상입니다.\n\n이상 신호: 진행했는데 0이면 전환이 막힌 것입니다.\n\n점검 순서: 결과별 턴 전환 수 패널에서 rejected 등 다른 결과와 오류 코드를 봅니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(antlab_turn_advance_total{application=~\"$application\",outcome=\"committed\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
