{
  "uid": "antlab-jvm-db",
  "title": "ant-lab · JVM and DB pool",
  "tags": [
    "antlab"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 42,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "antlab-prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(jvm_info, application)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(jvm_info, application)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "antlab-api",
          "value": "antlab-api"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "description": "Time since the JVM started. / JVM이 시작된 뒤 지난 시간.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "max(process_uptime_seconds{application=~\"$application\"})",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Hikari timeouts in range",
      "description": "Connection requests that timed out in the selected time range (red above 0). / 선택한 시간 범위에서 연결 대기가 시간 초과된 횟수(0 초과면 빨강).",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          },
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum(increase(hikaricp_connections_timeout_total{application=~\"$application\"}[$__range]))",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Heap used by pool",
      "description": "Used heap per memory pool, stacked. / 메모리 풀별 사용 중인 힙(누적).",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum by (id) (jvm_memory_used_bytes{application=~\"$application\",area=\"heap\"})",
          "legendFormat": "{{id}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Heap committed / max",
      "description": "Committed heap and the heap limit (pools without a limit are left out). / 확보한 힙과 힙 한도(한도 없는 풀은 제외).",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum(jvm_memory_committed_bytes{application=~\"$application\",area=\"heap\"})",
          "legendFormat": "committed",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{application=~\"$application\",area=\"heap\"} > 0)",
          "legendFormat": "max",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Non-heap used",
      "description": "Used non-heap memory per pool (metaspace, code cache). / 풀별 사용 중인 비힙 메모리(메타스페이스, 코드 캐시).",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum by (id) (jvm_memory_used_bytes{application=~\"$application\",area=\"nonheap\"})",
          "legendFormat": "{{id}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GC pause time",
      "description": "Time spent in GC pauses per second, and the longest pause. Empty until the first GC pause. / 초당 GC 멈춤 시간과 가장 긴 멈춤. 첫 GC 멈춤 전에는 비어 있다.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum by (gc, cause) (rate(jvm_gc_pause_seconds_sum{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "{{gc}} {{cause}}",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "B",
          "expr": "max by (gc) (jvm_gc_pause_seconds_max{application=~\"$application\"})",
          "legendFormat": "max {{gc}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GC overhead",
      "description": "Share of CPU time used by garbage collection. / 가비지 컬렉션이 쓴 CPU 시간 비율.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "max(jvm_gc_overhead{application=~\"$application\"})",
          "legendFormat": "overhead",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Threads",
      "description": "Live, daemon and peak thread counts. / 살아 있는 스레드, 데몬 스레드, 최대 스레드 수.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "max(jvm_threads_live_threads{application=~\"$application\"})",
          "legendFormat": "live",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "B",
          "expr": "max(jvm_threads_daemon_threads{application=~\"$application\"})",
          "legendFormat": "daemon",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "C",
          "expr": "max(jvm_threads_peak_threads{application=~\"$application\"})",
          "legendFormat": "peak",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Thread states",
      "description": "Threads by state, stacked. / 상태별 스레드 수(누적).",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 30,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum by (state) (jvm_threads_states_threads{application=~\"$application\"})",
          "legendFormat": "{{state}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Hikari connections",
      "description": "Database pool: active, idle and pending connections against the pool maximum. / DB 연결 풀: 사용 중·유휴·대기 연결 수와 풀 최대값.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum by (pool) (hikaricp_connections_active{application=~\"$application\"})",
          "legendFormat": "active",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "B",
          "expr": "sum by (pool) (hikaricp_connections_idle{application=~\"$application\"})",
          "legendFormat": "idle",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "C",
          "expr": "sum by (pool) (hikaricp_connections_pending{application=~\"$application\"})",
          "legendFormat": "pending",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "D",
          "expr": "max by (pool) (hikaricp_connections_max{application=~\"$application\"})",
          "legendFormat": "max",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Hikari acquire time",
      "description": "Average and maximum wait for a pool connection. The metric is a summary, so there is no quantile. / 풀 연결을 얻기까지 평균·최대 대기 시간. 요약(summary) 지표라 분위수는 없다.",
      "datasource": {
        "type": "prometheus",
        "uid": "antlab-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "A",
          "expr": "sum(rate(hikaricp_connections_acquire_seconds_sum{application=~\"$application\"}[$__rate_interval])) / sum(rate(hikaricp_connections_acquire_seconds_count{application=~\"$application\"}[$__rate_interval]))",
          "legendFormat": "avg",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "antlab-prometheus"
          },
          "refId": "B",
          "expr": "max(hikaricp_connections_acquire_seconds_max{application=~\"$application\"})",
          "legendFormat": "max",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "CPU",
      "description": "CPU use of the API process and of the whole machine. / API 프로세스와 시스템 전체의 CPU 사용률.",
