          "rawSql": "SELECT market AS \"market\", source AS \"source\", last_price_date AS \"newest date\", CURRENT_DATE - last_price_date AS \"age\", asset_count AS \"assets\" FROM obs.price_freshness ORDER BY market, source"
        }
      ],
